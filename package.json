{
  "name": "askuserquestionspro",
  "version": "1.1.0",
  "description": "Claude Code ve Codex App/CLI için yerel, tam ekran ve yapılandırılmış soru-cevap arayüzü.",
  "type": "commonjs",
  "author": "oğuz kerem ayhan <oguzkeremayhan@hotmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozkayhan/AskUserQuestionsPro.git"
  },
  "bugs": {
    "url": "https://github.com/ozkayhan/AskUserQuestionsPro/issues"
  },
  "homepage": "https://github.com/ozkayhan/AskUserQuestionsPro#readme",
  "bin": {
    "askuserquestionspro": "bin/cli.js",
    "askuserquestionspro-mcp": "mcp-server/askuserquestionspro-mcp.mjs"
  },
  "files": [
    "bin/",
    "hooks/",
    "server/",
    "lib/",
    "mcp-server/",
    "web/",
    "skill/",
    "install.sh",
    "uninstall.sh",
    "reinstall.sh",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:browser": "node test/browser-settings-cli-e2e.js",
    "serve": "node server/server.js",
    "mcp": "node mcp-server/askuserquestionspro-mcp.mjs",
    "install-hook": "node bin/cli.js install",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --ignore-unknown --check bin hooks lib mcp-server server test web docs package.json eslint.config.js .prettierrc.json README.md '*.sh'"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "chatgpt-desktop",
    "askuserquestion",
    "request-user-input",
    "hook",
    "cli",
    "amoled"
  ],
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "eslint": "^9.15.0",
    "@eslint/js": "^9.15.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "eslint-config-prettier": "^9.1.0",
    "@babel/core": "^7.24.0",
    "@babel/eslint-parser": "^7.24.0",
    "@babel/preset-react": "^7.24.0",
    "eslint-plugin-react-hooks": "^5.0.0"
  }
}
